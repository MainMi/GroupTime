<main>
    <section class="confirmBlock">
        <% if(title){ %>
            <h2 class="titleText"><%- title %></h2>
        <% } %>
        <% if(subtitle){ %>
            <p><%- subtitle %></p>
            <% hrefs.forEach(href => { %>
                <p><%- href %></p>
            <% }) %>
        <% } %>
        <% btnTexts.forEach((btnText, index) => { %>
            <a class="btn" href="<%- hrefs[index] %>"><%- btnText %></a>
        <% }) %>
    </section>
    <div class="circle"></div>
    <div class="cube"></div>
</main>
